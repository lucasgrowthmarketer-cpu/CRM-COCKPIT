# ============================================================================
# Industrial Decision Cockpit — environment variables
# ============================================================================
# Copy this file to backend/.env and frontend/.env and fill in the values.
# Never commit real .env files to git.
#
# ============================================================================
# BACKEND (.env to be placed in /backend)
# ============================================================================

# MongoDB connection string
MONGO_URL="mongodb://localhost:27017"

# Database name (defaults to industrial_decision)
DB_NAME="industrial_decision"

# JWT secret — REQUIRED, the app refuses to start without it.
# Generate a strong random string, e.g.:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET="CHANGE-ME-to-a-long-random-string"

# CORS whitelist — comma-separated list of allowed origins.
# In development: http://localhost:3000
# In production: the real domain of your frontend
CORS_ORIGINS="http://localhost:3000"

# ============================================================================
# FRONTEND (.env to be placed in /frontend)
# ============================================================================

# URL where the backend API is reachable from the browser
REACT_APP_BACKEND_URL="http://localhost:8000"
